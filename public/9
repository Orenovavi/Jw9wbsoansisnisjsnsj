<style>
    * {
      -webkit-tap-highlight-color: transparent;
      outline: none;
    }
    body {
      background-color: #F5F3EF;
      color: #111827;
    }
    
    /* Scrollbar Cream/Emerald Minimalis */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F5F3EF;
      border-left: 2px solid #111827;
    }
    ::-webkit-scrollbar-thumb {
      background: #059669;
      border: 2px solid #111827;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #4F46E5;
    }

    /* Dynamic Island Soft Glass */
    .dynamic-island {
      background: #111827;
      color: #FFFFFF;
      border: 2.5px solid #111827;
      box-shadow: 4px 4px 0px 0px #059669;
      border-radius: 18px 6px 18px 6px;
      transition: all 250ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dynamic-island:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px 0px #4F46E5;
    }
    .dynamic-island.expanded {
      border-radius: 20px;
      box-shadow: 6px 6px 0px 0px #059669;
    }

    /* Box Modern dengan Asymmetric Rounded Corners */
    .neo-box {
      background-color: #FFFFFF;
      border: 2.5px solid #111827;
      border-radius: 18px 6px 18px 6px; /* Bentuk asimetris modern */
      box-shadow: 5px 5px 0px 0px #111827;
      transition: all 150ms ease;
    }

    /* Tombol Interaktif Pro */
    .neo-btn {
      background-color: #FFFFFF;
      border: 2.5px solid #111827;
      border-radius: 12px 4px 12px 4px;
      box-shadow: 3px 3px 0px 0px #111827;
      transition: all 120ms ease;
      font-weight: 700;
    }
    .neo-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px 0px #059669;
      background-color: #ECFDF5;
    }
    .neo-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0px 0px #111827;
    }

    /* Grid Folder Dropdown Smooth Collapse */
    .folder-content {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .folder-content.open {
      grid-template-rows: 1fr;
    }

    /* Item Card dengan Tint Warna Modern saat Hover */
    .card-item {
      background-color: #FFFFFF;
      border: 2.5px solid #111827;
      border-radius: 16px 4px 16px 4px;
      box-shadow: 4px 4px 0px 0px #111827;
      transition: all 150ms ease;
      animation: cardAppear 250ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    .card-item:hover {
      transform: translate(-3px, -3px);
      box-shadow: 7px 7px 0px 0px #4F46E5;
      background-color: #EEF2FF !important;
    }

    @keyframes cardAppear {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Bottom Sheet / Modal */
    .modal-sheet {
      transform: translateY(100%);
      transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: 24px 24px 0 0;
      border-top: 3px solid #111827;
      background: #FFFFFF;
    }
    .modal-sheet.active {
      transform: translateY(0);
    }

    /* Touch Effect Emerald */
    .touch-ripple {
      position: fixed;
      border-radius: 9999px;
      pointer-events: none;
      z-index: 9999;
      transform: scale(0.2);
      opacity: 0.85;
      background: #059669;
      border: 2px solid #111827;
      transition: transform 400ms ease, opacity 400ms ease;
    }

    /* Terminal Cursor */
    .terminal-cursor {
      display: inline-block;
      width: 8px;
      height: 18px;
      background-color: #059669;
      vertical-align: middle;
      animation: blinkCursor 600ms infinite steps(1);
    }
    @keyframes blinkCursor {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    /* SweetAlert Light Modern */
    .swal2-popup.custom-swal-center {
      background: #FFFFFF !important;
      border: 3px solid #111827 !important;
      border-radius: 16px 4px 16px 4px !important;
      padding: 1.5rem !important;
      box-shadow: 6px 6px 0px 0px #059669 !important;
