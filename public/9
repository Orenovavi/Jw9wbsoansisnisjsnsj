  <script>
    let registry = {};
    let activeEndpoint = null;
    let currentCategory = 'all';
    let isTerminalTyping = false;
    let rawResponseText = '';
    const openFolders = new Set();
    let isIslandExpanded = false;

    window.addEventListener('pointerdown', (e) => {
      const ripple = document.createElement('div');
      ripple.className = 'touch-ripple';
      const size = 36;
      ripple.style.width = `${size}px`;
      ripple.style.height = `${size}px`;
      ripple.style.left = `${e.clientX - size / 2}px`;
      ripple.style.top = `${e.clientY - size / 2}px`;
      document.body.appendChild(ripple);

      requestAnimationFrame(() => {
        ripple.style.transform = 'scale(2.5)';
        ripple.style.opacity = '0';
      });

      setTimeout(() => ripple.remove(), 400);
    });

    function toggleDynamicIsland() {
      const container = document.getElementById('island-container');
      const menu = document.getElementById('island-menu');
      const chevron = document.getElementById('island-chevron');

      isIslandExpanded = !isIslandExpanded;

      if (isIslandExpanded) {
        container.classList.add('expanded');
        container.style.width = window.innerWidth < 640 ? '300px' : '340px';
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        chevron.style.transform = 'rotate(180deg)';
      } else {
        closeIsland();
      }
    }

    function closeIsland() {
      const container = document.getElementById('island-container');
      const menu = document.getElementById('island-menu');
      const chevron = document.getElementById('island-chevron');

      isIslandExpanded = false;
      container.classList.remove('expanded');
      container.style.width = '';
      menu.classList.remove('flex');
      menu.classList.add('hidden');
      chevron.style.transform = 'rotate(0deg)';
    }

    function handleIslandNav(view) {
      closeIsland();
      smoothNavigate(view);
    }

    window.addEventListener('click', (e) => {
      const container = document.getElementById('island-container');
      if (isIslandExpanded && !container.contains(e.target)) {
        closeIsland();
      }
    });

    function smoothNavigate(targetView) {
      const homeView = document.getElementById('view-home');
      const docsView = document.getElementById('view-docs');

      const current = targetView === 'docs' ? homeView : docsView;
      const destination = targetView === 'docs' ? docsView : homeView;

      current.classList.remove('view-enter');
      current.classList.add('view-leave');

      setTimeout(() => {
        current.classList.add('hidden');
        destination.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });

        setTimeout(() => {
          destination.classList.remove('view-leave');
          destination.classList.add('view-enter');
        }, 50);
      }, 200);
    }

    const notify = (icon, title) => {
      Swal.fire({
        icon,
        title,
        position: 'center',
        showConfirmButton: false,
        timer: 1600,
        customClass: { popup: 'custom-swal-center' },
        iconColor: '#000000'
      });
    };

    const formatCodeHighlight = (data) => {
      let json = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
      json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, (match) => {
        let cls = 'json-number';
        if (/^"/.test(match)) {
          cls = /:$/.test(match) ? 'json-key' : 'json-string';
        } else if (/true|false/.test(match)) {
          cls = 'json-boolean';
        } else if (/null/.test(match)) {
          cls = 'json-null';
        }
        return `<span class="${cls}">${match}</span>`;
      });
    };

    const typeTerminalLine = (text, speed = 16) => {
      return new Promise((resolve) => {
        const typingEl = document.getElementById('terminal-typing');
        const terminalBody = document.getElementById('terminal-body');
        let index = 0;
        typingEl.textContent = '';

        const interval = setInterval(() => {
          if (index < text.length) {
            typingEl.textContent += text.charAt(index);
            index++;
            terminalBody.scrollTop = terminalBody.scrollHeight;
          } else {
            clearInterval(interval);
            setTimeout(resolve, 35);
          }
        }, speed);
      });
    };

    const commitTerminalLine = (colorClass = 'text-white/60') => {
      const typingEl = document.getElementById('terminal-typing');
      const contentEl = document.getElementById('terminal-content');
      const terminalBody = document.getElementById('terminal-body');

      const lineDiv = document.createElement('div');
      lineDiv.className = colorClass;
      lineDiv.textContent = typingEl.textContent;
      contentEl.appendChild(lineDiv);
      typingEl.textContent = '';
      terminalBody.scrollTop = terminalBody.scrollHeight;
    };

    const runConsoleBootSequence = async () => {
      if (isTerminalTyping) return;
      isTerminalTyping = true;

      const contentEl = document.getElementById('terminal-content');
      contentEl.innerHTML = '';

      await typeTerminalLine('[  OK  ] Native Node.js ESM Runtime Initialized', 8);
      commitTerminalLine('text-neo-lime font-mono font-bold');

      await typeTerminalLine('[  OK  ] Synchronized Router Engine with Plugin Watcher', 8);
      commitTerminalLine('text-neo-lime font-mono font-bold');

      await typeTerminalLine('root@denzcone:~# DenzcOne scan api --active', 12);
      commitTerminalLine('text-neo-yellow font-bold');

      const categories = Object.keys(registry);
      let totalLoaded = 0;

      for (const cat of categories) {
        const list = registry[cat] || [];
        for (const ep of list) {
          totalLoaded++;
          const method = (ep.method && ep.method[0]) || 'GET';
          await typeTerminalLine(`[LOADED] ${method} ${ep.endpoint}`, 5);
          commitTerminalLine('text-neo-cyan font-mono');
        }
      }

      await typeTerminalLine(`[INFO] ${totalLoaded} endpoints loaded across ${categories.length} categories`, 8);
      commitTerminalLine('text-white font-bold');

      await typeTerminalLine('root@denzcone:~# ready', 8);
      commitTerminalLine('text-white/40');

      isTerminalTyping = false;
    };

    async function rescanConsole() {
      await fetchEndpoints();
      await runConsoleBootSequence();
      notify('info', 'Registry disinkronisasi');
    }

    async function fetchEndpoints() {
      try {
        const res = await fetch(`/api/endpoints?_t=${Date.now()}`, {
          cache: "no-store",
          headers: { "Pragma": "no-cache", "Cache-Control": "no-cache" }
        });
        const data = await res.json();

        if (data.status && data.result) {
          registry = data.result.endpoints || {};
          document.getElementById('stat-total').textContent = data.result.total || 0;
          document.getElementById('stat-categories').textContent = Object.keys(registry).length;

          buildCategoryTabs();
          renderEndpoints();
        }
      } catch (err) {
        document.getElementById('endpoint-container').innerHTML = `
          <div class="text-center py-12 bg-neo-pink text-white font-black border-3 border-black neo-box">
            Gagal memuat daftar endpoint dari server.
          </div>
        `;
      }
    }

    function buildCategoryTabs() {
      const container = document.getElementById('category-tabs');
      container.innerHTML = `
        <button onclick="filterCategory('all')" class="px-5 py-2.5 text-xs font-black uppercase neo-btn ${currentCategory === 'all' ? 'bg-neo-yellow text-black' : 'bg-white text-black'}">
          Semua Folder
        </button>
      `;

      Object.keys(registry).forEach(cat => {
        const btn = document.createElement('button');
        btn.onclick = () => filterCategory(cat);
        btn.className = `px-5 py-2.5 text-xs font-black uppercase neo-btn ${currentCategory === cat ? 'bg-neo-pink text-white' : 'bg-white text-black'}`;
        btn.textContent = cat;
        container.appendChild(btn);
      });
    }

    function filterCategory(cat) {
      currentCategory = cat;
      buildCategoryTabs();
      renderEndpoints(document.getElementById('search-input').value.trim().toLowerCase());
    }

    function toggleFolder(cat) {
      const content = document.getElementById(`folder-content-${cat}`);
      const chevron = document.getElementById(`folder-chevron-${cat}`);
      const icon = document.getElementById(`folder-icon-${cat}`);

      if (!content) return;

      const isNowOpen = !openFolders.has(cat);

      if (isNowOpen) {
        openFolders.add(cat);
        content.classList.add('open');
        chevron.style.transform = 'rotate(180deg)';
        icon.setAttribute('data-lucide', 'folder-open');
      } else {
        openFolders.delete(cat);
        content.classList.remove('open');
        chevron.style.transform = 'rotate(0deg)';
        icon.setAttribute('data-lucide', 'folder');
      }
      lucide.createIcons();
    }

    function renderEndpoints(searchQuery = '') {
      const container = document.getElementById('endpoint-container');
      container.innerHTML = '';

      const categories = Object.keys(registry);
      let count = 0;

      categories.forEach(cat => {
        if (currentCategory !== 'all' && currentCategory !== cat) return;

        const endpoints = registry[cat].filter(ep => {
          if (!searchQuery) return true;
          return ep.name.toLowerCase().includes(searchQuery) ||
                 ep.endpoint.toLowerCase().includes(searchQuery) ||
                 ep.description.toLowerCase().includes(searchQuery);
        });

        if (endpoints.length === 0) return;
        count += endpoints.length;

        if (currentCategory === 'all' && !searchQuery) {
          const isOpen = openFolders.has(cat);
          const folderBox = document.createElement('div');
          folderBox.className = 'bg-white border-3 border-black neo-box overflow-hidden shadow-neo';

          folderBox.innerHTML = `
            <div onclick="toggleFolder('${cat}')" class="p-5 flex items-center justify-between cursor-pointer bg-neo-yellow hover:bg-neo-cyan transition-colors select-none border-b-3 border-black">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white border-2 border-black flex items-center justify-center shrink-0 shadow-neo-sm">
                  <i data-lucide="${isOpen ? 'folder-open' : 'folder'}" id="folder-icon-${cat}" class="w-5 h-5 text-black"></i>
                </div>
                <div>
                  <h3 class="text-sm font-black uppercase tracking-wider text-black font-mono">${cat}</h3>
                  <span class="text-xs text-black font-bold">${endpoints.length} endpoints</span>
                </div>
              </div>
              <div class="w-9 h-9 bg-white border-2 border-black flex items-center justify-center text-black shadow-neo-sm">
                <i data-lucide="chevron-down" id="folder-chevron-${cat}" class="w-5 h-5 font-black transition-transform duration-300" style="transform: ${isOpen ? 'rotate(180deg)' : 'rotate(0deg)'}"></i>
              </div>
            </div>
            <div id="folder-content-${cat}" class="folder-content ${isOpen ? 'open' : ''}">
              <div class="overflow-hidden">
                <div class="p-5 bg-neo-bg grid grid-cols-1 md:grid-cols-2 gap-4 border-t-3 border-black" id="folder-grid-${cat}"></div>
              </div>
            </div>
          `;

          container.appendChild(folderBox);

          const grid = document.getElementById(`folder-grid-${cat}`);
          endpoints.forEach((ep, i) => {
            const cardEl = createEndpointCard(ep);
            cardEl.style.animationDelay = `${i * 30}ms`;
            grid.appendChild(cardEl);
          });
        } else {
          const block = document.createElement('div');
          block.className = 'space-y-4';

          block.innerHTML = `
            <div class="flex items-center gap-2 pb-2 border-b-3 border-black">
              <span class="w-3 h-3 border-2 border-black bg-neo-pink"></span>
              <h3 class="text-xs font-black uppercase tracking-wider text-black font-mono">${cat}</h3>
              <span class="text-xs text-black font-mono font-bold">(${endpoints.length})</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="grid-${cat}"></div>
          `;

          container.appendChild(block);

          const grid = document.getElementById(`grid-${cat}`);
          endpoints.forEach((ep, i) => {
            const cardEl = createEndpointCard(ep);
            cardEl.style.animationDelay = `${i * 30}ms`;
            grid.appendChild(cardEl);
          });
        }
      });

      if (count === 0) {
        container.innerHTML = `
          <div class="text-center py-16 bg-neo-orange border-3 border-black font-mono font-black text-sm neo-box">
            TIDAK ADA ENDPOINT YANG COCOK DENGAN PENCARIAN.
          </div>
        `;
      }

      lucide.createIcons();
    }

    function createEndpointCard(ep) {
      const card = document.createElement('div');
      card.className = 'p-5 bg-white card-item cursor-pointer flex flex-col justify-between';
      card.onclick = () => openModal(ep);

      const method = (ep.method && ep.method[0]) || 'GET';
      const methodBadge = method === 'POST' ? 'bg-neo-cyan text-black' : 'bg-neo-lime text-black';

      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h4 class="text-sm font-black text-black uppercase tracking-tight">${ep.name}</h4>
            <span class="px-2.5 py-0.5 border-2 border-black text-[10px] font-mono font-black shadow-neo-sm ${methodBadge}">${method}</span>
          </div>
          <p class="text-xs text-black leading-relaxed mb-4 font-bold">${ep.description || 'Tanpa deskripsi tambahan.'}</p>
        </div>
        <div class="flex items-center justify-between pt-3 border-t-2 border-black text-xs font-mono">
          <span class="truncate max-w-[200px] text-black font-bold bg-neo-yellow px-2 py-0.5 border border-black">${ep.endpoint}</span>
          <div class="flex items-center gap-1 font-black uppercase text-black hover:underline">
            <span>Tes</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </div>
        </div>
      `;
      return card;
    }

    function openModal(ep) {
      activeEndpoint = ep;
      const modal = document.getElementById('modal-sheet');
      const backdrop = document.getElementById('modal-backdrop');

      document.getElementById('modal-title').textContent = ep.name;
      document.getElementById('modal-desc').textContent = ep.description || '-';
      document.getElementById('modal-path').textContent = ep.endpoint;

      const method = (ep.method && ep.method[0]) || 'GET';
      document.getElementById('modal-badge-method').textContent = method;

      const inputsContainer = document.getElementById('modal-inputs');
      inputsContainer.innerHTML = '';

      const params = ep.params || {};
      const keys = Object.keys(params);

      if (keys.length === 0) {
        inputsContainer.innerHTML = `
          <div class="text-xs font-bold font-mono text-black p-3 bg-neo-yellow border-2 border-black">
            Endpoint ini tidak memerlukan parameter input.
          </div>
        `;
      } else {
        keys.forEach(key => {
          const item = params[key];
          const isRequired = typeof item === 'object' ? item.required : false;
          const desc = typeof item === 'object' ? item.description : '';

          const group = document.createElement('div');
          group.className = 'space-y-1.5';
          group.innerHTML = `
            <div class="flex items-center justify-between text-xs">
              <label class="font-black text-black font-mono uppercase">${key} ${isRequired ? '<span class="text-neo-pink">*</span>' : ''}</label>
              <span class="text-[10px] font-bold text-black">${desc}</span>
            </div>
            <input type="text" name="${key}" ${isRequired ? 'required' : ''} placeholder="Nilai untuk ${key}..." class="w-full px-3.5 py-3 text-xs bg-white border-2 border-black font-mono font-bold text-black placeholder-black focus:bg-neo-cyan shadow-neo-sm transition-colors" />
          `;
          inputsContainer.appendChild(group);
        });
      }

      document.getElementById('modal-response-wrapper').classList.add('hidden');
      document.body.style.overflow = 'hidden';

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');

      modal.classList.add('active');
      lucide.createIcons();
    }

    function closeModal() {
      const modal = document.getElementById('modal-sheet');
      const backdrop = document.getElementById('modal-backdrop');

      modal.classList.remove('active');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      document.body.style.overflow = '';
      activeEndpoint = null;
    }

    async function executeRequest(e) {
      e.preventDefault();
      if (!activeEndpoint) return;

      const submitBtn = document.getElementById('btn-submit');
      const submitText = document.getElementById('btn-submit-text');
      const submitIcon = document.getElementById('btn-submit-icon');
      const responseWrapper = document.getElementById('modal-response-wrapper');
      const responseBody = document.getElementById('modal-response-body');
      const statusPill = document.getElementById('modal-status-pill');
      const timePill = document.getElementById('modal-time-pill');

      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-60');
      submitText.textContent = 'Memproses Request...';
      submitIcon.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>';
      lucide.createIcons();

      const formData = new FormData(e.target);
      const queryParams = new URLSearchParams();
      const bodyPayload = {};

      for (const [key, val] of formData.entries()) {
        if (val.trim()) {
          queryParams.append(key, val.trim());
          bodyPayload[key] = val.trim();
        }
      }

      const method = (activeEndpoint.method && activeEndpoint.method[0]) || 'GET';
      let url = activeEndpoint.endpoint;

      const options = { method };

      if (method === 'GET') {
        const qs = queryParams.toString();
        if (qs) url += `?${qs}`;
      } else {
        options.headers = { 'Content-Type': 'application/json' };
        options.body = JSON.stringify(bodyPayload);
      }

      const start = performance.now();

      try {
        const response = await fetch(url, options);
        const duration = Math.round(performance.now() - start);
        const json = await response.json();

        rawResponseText = JSON.stringify(json, null, 2);

        statusPill.textContent = `${response.status} ${response.statusText || 'OK'}`;
        statusPill.className = response.ok 
          ? 'text-xs font-mono font-black px-2 py-0.5 border-2 border-black bg-neo-lime text-black'
          : 'text-xs font-mono font-black px-2 py-0.5 border-2 border-black bg-neo-pink text-white';

        timePill.textContent = `${duration}ms`;
        responseBody.innerHTML = formatCodeHighlight(json);
        responseWrapper.classList.remove('hidden');

        if (response.ok) {
          notify('success', `Berhasil (${response.status})`);
        } else {
          notify('error', json.message || 'Request Gagal');
        }
      } catch (err) {
        const duration = Math.round(performance.now() - start);
        const errorObj = { status: false, message: err.message };
        rawResponseText = JSON.stringify(errorObj, null, 2);

        statusPill.textContent = 'Error';
        statusPill.className = 'text-xs font-mono font-black px-2 py-0.5 border-2 border-black bg-neo-pink text-white';
        timePill.textContent = `${duration}ms`;
        responseBody.innerHTML = formatCodeHighlight(errorObj);
        responseWrapper.classList.remove('hidden');

        notify('error', err.message || 'Gagal mengeksekusi request');
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-60');
        submitText.textContent = 'Jalankan Request';
        submitIcon.innerHTML = '<i data-lucide="send" class="w-4 h-4"></i>';
        lucide.createIcons();
      }
    }

    function copyRoute() {
      if (!activeEndpoint) return;
      navigator.clipboard.writeText(window.location.origin + activeEndpoint.endpoint);
      notify('info', 'Route disalin');
    }

    function copyResponse() {
      if (rawResponseText) {
        navigator.clipboard.writeText(rawResponseText);
        notify('info', 'JSON disalin');
      }
    }

    async function checkLatency() {
      const bottomDisplay = document.getElementById('bottom-latency');
      const start = performance.now();
      try {
        await fetch('/tools/ping');
        const duration = Math.round(performance.now() - start);
        bottomDisplay.textContent = `${duration}ms`;
      } catch {
        bottomDisplay.textContent = 'Offline';
      }
    }

    window.addEventListener("DOMContentLoaded", async () => {
      lucide.createIcons();
      await fetchEndpoints();
      checkLatency();
      await runConsoleBootSequence();

      document.getElementById('search-input').addEventListener('input', (e) => {
        renderEndpoints(e.target.value.trim().toLowerCase());
      });
    });
  </script>
</body>
